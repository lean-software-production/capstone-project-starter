{
  "name": "Capstone Project Starter",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-24-trixie",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt@26.5908.31748"
      ]
    }
  },
  "features": {
    "ghcr.io/lean-software-production/devcontainer-features/pi:1": {},
    "ghcr.io/lean-software-production/devcontainer-features/claude-code:1": {},
    "ghcr.io/lean-software-production/devcontainer-features/codex:1": {
      "model": "gpt-6-sol",
      "fullAccess": true
    },
    "ghcr.io/lean-software-production/devcontainer-features/bb:1": {
      "version": "0.45.0",
      "mode": "machine",
      "autoStart": true,
      "dataDir": "/workspaces/.bb-machine"
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/tools/pi-rpc-acp"
  },
  "postCreateCommand": "(npm install -g @agentclientprotocol/claude-agent-acp @agentclientprotocol/codex-acp || true) && (bin/doctor || true)"
}
